{
  "name": "GadgetGrid",
  "version": "1.0.0",
  "description": "Ecommerce app using MERN stack",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node Backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "build": "npm install && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "generate-toc": "markdown-toc -i readme.md"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "@types/express": "^4.17.17",
    "baseline-browser-mapping": "^2.11.38",
    "concurrently": "^7.6.0",
    "markdown-toc": "^1.2.0",
    "nodemon": "^2.0.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PraveenVaidyaBM/P-Mart.git"
  },
  "author": "Praveen Vaidya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PraveenVaidyaBM/P-Mart/issues"
  },
  "homepage": "https://github.com/PraveenVaidyaBM/P-Mart#readme"
}
